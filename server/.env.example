NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/khamar_fresh

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES=7d

# URLs (SITE_URL is used for Open Graph absolute links & sitemap)
CLIENT_URL=http://localhost:5173
SITE_URL=http://localhost:5173

# First admin (created by `npm run seed`)
ADMIN_NAME=Owner
ADMIN_EMAIL=admin@khamarfresh.com
ADMIN_PASSWORD=ChangeMe@123

# SMS gateway: log | bulksmsbd | custom
SMS_PROVIDER=log
SMS_API_KEY=
SMS_SENDER_ID=
SMS_API_URL=

# SSLCommerz (sandbox by default)
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASS=
SSLCOMMERZ_SANDBOX=true
API_PUBLIC_URL=http://localhost:5000

# bKash / Nagad merchant API (hooks ready in utils/payments.js)
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_BASE_URL=
NAGAD_MERCHANT_ID=
NAGAD_PUBLIC_KEY=
NAGAD_PRIVATE_KEY=
NAGAD_BASE_URL=
